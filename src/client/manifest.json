{
	"name": "WebGPU inspector",
	"description": "WebGPU inspector",
	"version": "0.0.1",
	"manifest_version": 3,
	"icons": {
		"128": "/img/icon_128.png"
	},
	"content_scripts": [
		{
			"matches": [
				"<all_urls>"
			],
			"js": [
				"content.js"
			],
			"all_frames": true,
			"run_at": "document_start",
			"world": "MAIN"
		},
		{
			"matches": [
				"<all_urls>"
			],
			"js": [
				"isolated.js"
			],
			"all_frames": true,
			"run_at": "document_start"
		}
	],
	"web_accessible_resources": [
		{
			"resources": [
				"assets/*"
			],
			"matches": [
				"<all_urls>"
			]
		}
	]
}
